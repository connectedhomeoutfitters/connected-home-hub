<!doctype html>
<html>
<body style="font-family: 'Roboto', Arial, Helvetica, sans-serif; color: #333; max-width: 560px; margin: 0 auto;">
  <%- include('_header') %>
  <p>Hi <%= customerName %>,</p>
  <p>Thanks for accepting your estimate! To get your job scheduled, please pay the deposit below.</p>
  <p style="font-size: 18px;">Deposit due: <strong>$<%= amount %></strong></p>
  <p style="margin: 24px 0;">
    <a href="<%= payUrl %>" style="background: #0799D6; color: #fff; padding: 12px 24px; text-decoration: none; border-radius: 4px;">
      Pay Deposit
    </a>
  </p>
  <p style="color: #666; font-size: 13px;">Or copy this link into your browser: <%= payUrl %></p>
  <%- include('_footer') %>
</body>
</html>
