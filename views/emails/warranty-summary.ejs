<!doctype html>
<html>
<body style="font-family: 'Roboto', Arial, Helvetica, sans-serif; color: #333; max-width: 560px; margin: 0 auto;">
  <%- include('_header') %>
  <p>Hi <%= customerName %>,</p>
  <p>Your project<%= projectTitle ? ' — <strong>' + projectTitle + '</strong>' : '' %> is complete. Thank you for choosing
     Connected Home Outfitters!</p>

  <% if (warranties && warranties.length) { %>
    <p>For your records, here is your warranty documentation:</p>
    <table style="width: 100%; border-collapse: collapse; font-size: 14px; margin: 12px 0;">
      <thead>
        <tr style="text-align: left; border-bottom: 2px solid #6EC1E4;">
          <th style="padding: 6px 4px;">Item</th><th style="padding: 6px 4px;">Provider</th><th style="padding: 6px 4px;">Covered through</th>
        </tr>
      </thead>
      <tbody>
        <% warranties.forEach(w => { %>
          <tr style="border-bottom: 1px solid #eee;">
            <td style="padding: 6px 4px;"><%= w.item %></td>
            <td style="padding: 6px 4px;"><%= w.provider || '—' %></td>
            <td style="padding: 6px 4px;"><%= w.expires_on ? new Date(w.expires_on).toLocaleDateString('en-US', { dateStyle: 'long' }) : 'See coverage terms' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <p style="color: #7A7A7A; font-size: 13px;">You can also view your warranties any time in your customer portal.</p>
  <% } else { %>
    <p>We stand behind our work — if anything needs attention, just reach out and we'll take care of you.</p>
  <% } %>

  <p>Questions about your installation or coverage? Just reply to this email.</p>
  <%- include('_footer') %>
</body>
</html>
