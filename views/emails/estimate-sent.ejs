<!doctype html>
<html>
<body style="font-family: 'Roboto', Arial, Helvetica, sans-serif; color: #333; max-width: 560px; margin: 0 auto;">
  <%- include('_header') %>
  <p>Hi <%= customerName %>,</p>
  <p>Your estimate <strong><%= estimateTitle %></strong> is ready to view. Total: <strong>$<%= total %></strong>.</p>
  <p style="margin: 24px 0;">
    <a href="<%= viewUrl %>" style="background: #0799D6; color: #fff; padding: 12px 24px; text-decoration: none; border-radius: 4px;">
      View &amp; Accept Estimate
    </a>
  </p>
  <p style="color: #666; font-size: 13px;">Or copy this link into your browser: <%= viewUrl %></p>
  <p>Questions? Just reply to this email.</p>
  <%- include('_footer') %>
</body>
</html>
