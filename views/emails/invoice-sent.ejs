<!doctype html>
<html>
<body style="font-family: 'Roboto', Arial, Helvetica, sans-serif; color: #333; max-width: 560px; margin: 0 auto;">
  <%- include('_header') %>
  <p>Hi <%= customerName %>,</p>
  <p>Here is your <%= invoiceType === 'final' ? 'final balance' : '' %> invoice from Connected Home Outfitters:</p>
  <p style="font-size: 20px; font-weight: bold; color: #0799D6; margin: 4px 0;">$<%= amount %></p>
  <% if (description) { %><p style="color: #7A7A7A; margin-top: 0;"><%= description %></p><% } %>
  <p style="text-align: center; margin: 28px 0;">
    <a href="<%= payUrl %>" style="background: #0799D6; color: #fff; text-decoration: none;
       padding: 12px 28px; border-radius: 6px; font-weight: bold; display: inline-block;">Pay invoice</a>
  </p>
  <p style="color: #7A7A7A; font-size: 13px;">You can pay securely by card at the link above. Questions? Just reply to this email.</p>
  <%- include('_footer') %>
</body>
</html>
