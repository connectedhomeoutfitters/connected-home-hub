<!doctype html>
<html>
<body style="font-family: 'Roboto', Arial, Helvetica, sans-serif; color: #333; max-width: 560px; margin: 0 auto;">
  <%- include('_header') %>
  <p>Hi <%= customerName %>,</p>
  <p>Your smart home consultation has <%= typeof rescheduled !== 'undefined' && rescheduled ? 'been rescheduled to' : 'been confirmed for' %>:</p>
  <p style="font-size: 18px; font-weight: bold; color: #0799D6;"><%= when %></p>
  <% if (address) { %><p><%= address %></p><% } %>
  <p>A calendar invite is attached — accept it to add this to your own calendar.</p>
  <p>Questions? Just reply to this email.</p>
  <%- include('_footer') %>
</body>
</html>
