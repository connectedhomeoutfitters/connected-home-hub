<!doctype html>
<html>
<body style="font-family: 'Roboto', Arial, Helvetica, sans-serif; color: #333; max-width: 560px; margin: 0 auto;">
  <%- include('_header') %>
  <p>Hi <%= customerName %>,</p>
  <p>Here's your secure sign-in link for the <%= appName %> customer portal —
     click below to view your estimates, invoices, and payment history:</p>
  <p style="text-align: center; margin: 28px 0;">
    <a href="<%= loginUrl %>" style="background: #0799D6; color: #fff; text-decoration: none;
       padding: 12px 28px; border-radius: 6px; font-weight: bold; display: inline-block;">Sign in</a>
  </p>
  <p style="color: #7A7A7A; font-size: 13px;">This link expires in <%= ttlMinutes %> minutes and can
     only be used once. If you didn't request it, you can safely ignore this email.</p>
  <p style="color: #7A7A7A; font-size: 12px; word-break: break-all;">Or paste this URL into your browser:<br><%= loginUrl %></p>
  <%- include('_footer') %>
</body>
</html>
