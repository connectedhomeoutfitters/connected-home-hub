<%- include('../partials/head', { title: 'Subcontractor Portal', portalBranded: true, bodyClass: 'portal-page auth-page' }) %>
<%- include('../partials/portal-header', { productLink: true }) %>
<main class="auth-main">
  <div class="auth-card">
    <h1 class="h4 mb-1">Subcontractor Portal</h1>
    <p class="auth-card__sub">View the jobs assigned to you and your documents on file.</p>

  <% if (sent) { %>
    <div class="alert alert-success">
      <strong>Check your email.</strong> If that address is on file with us, we've sent a
      secure sign-in link. It expires in 30 minutes.
    </div>
    <a href="<%= basePath %>/sub/login" class="btn btn-outline-secondary w-100">Back</a>
  <% } else { %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <form action="<%= basePath %>/sub/login" method="POST">
      <div class="mb-3">
        <label class="form-label">Email address</label>
        <input type="email" name="email" class="form-control" required autofocus placeholder="you@example.com">
        <div class="form-text">We'll email you a one-time sign-in link — no password needed.</div>
      </div>
      <button class="btn btn-primary w-100" type="submit">Email me a sign-in link</button>
    </form>
  <% } %>

  </div>

  <p class="auth-alt">Work here? <a href="<%= basePath %>/login">Company sign in</a>
    <span class="auth-footer__sep">·</span>
    <a href="<%= basePath %>/portal/login">Customer sign in</a></p>
</main>
<%- include('../partials/auth-footer') %>
<%- include('../partials/footer') %>
