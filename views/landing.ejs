<%- include('partials/head', { title: 'ConnectedWorkOS', portalBranded: true, bodyClass: 'portal-page landing-page auth-page' }) %>
<%- include('partials/portal-header', { productLink: true }) %>
<div class="container py-5" style="max-width: 760px;">

  <div class="text-center mb-5">
    <h1 class="mb-3">ConnectedWorkOS</h1>
    <p class="lead" style="color: var(--cho-text);">
      Quotes, jobs, scheduling and payments for service businesses &mdash; lawn care,
      pool, pest control, cleaning, HVAC, plumbing and the trades alongside them.
    </p>
    <p style="color: var(--cho-text);">
      Choose the door that fits: customers review and pay, crews see their work, the
      company runs the job.
    </p>
  </div>

  <div class="row g-4">
    <div class="col-md-6">
      <div class="card h-100 text-center">
        <div class="card-body p-4">
          <i class="bi bi-house-heart" style="font-size: 2rem; color: var(--cho-accent);"></i>
          <h2 class="h5 mt-3">Customers</h2>
          <p class="small" style="color: var(--cho-text);">
            View your estimates, invoices, and payment history. Sign in with a secure
            email link — no password to remember.
          </p>
          <a href="<%= basePath %>/portal/login" class="btn btn-primary w-100">Customer portal</a>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card h-100 text-center">
        <div class="card-body p-4">
          <i class="bi bi-briefcase" style="font-size: 2rem; color: var(--cho-accent);"></i>
          <h2 class="h5 mt-3">Company</h2>
          <p class="small" style="color: var(--cho-text);">
            For the team running the work &mdash; office staff, crew leads and owners.
          </p>
          <a href="<%= basePath %>/login" class="btn btn-outline-secondary w-100">Company sign in</a>
        </div>
      </div>
    </div>
  </div>

  <p class="text-center small mt-4 mb-0" style="color: var(--cho-text);">
    Subcontractor? <a href="<%= basePath %>/sub/login">Sign in to your job portal</a>
  </p>
</div>
<%- include('partials/auth-footer') %>
<%- include('partials/footer') %>
