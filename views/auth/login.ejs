<%# Staff sign-in. Uses the same portal shell as the customer and subcontractor sign-in
    pages — before this it was bare Bootstrap on a grey page with no logo and no footer,
    which read as a different product from the one people had just come from. %>
<%- include('../partials/head', { title: 'Sign in', portalBranded: true, bodyClass: 'portal-page auth-page' }) %>
<%- include('../partials/portal-header', { productLink: true }) %>

<main class="auth-main">
  <div class="auth-card">
    <h1 class="h4 mb-1">Company sign in</h1>
    <p class="auth-card__sub">For the team running the work — office staff, crew leads and owners.</p>

    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <form action="<%= basePath %>/login" method="POST">
      <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input type="email" id="email" name="email" class="form-control" autocomplete="username" required>
      </div>
      <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required>
      </div>
      <button class="btn btn-primary w-100" type="submit">Sign in</button>
    </form>

    <% if (googleEnabled) { %>
      <div class="auth-or"><span>or</span></div>
      <a class="btn btn-outline-secondary w-100" href="<%= basePath %>/google">
        <i class="bi bi-google"></i> Sign in with Google
      </a>
    <% } %>
  </div>

  <%# The other two sign-in doors. Someone who lands here from an email link is often in
      the wrong one, and previously had no way across without going back to the landing page. %>
  <p class="auth-alt">
    Not part of the company?
    <a href="<%= basePath %>/portal/login">Customer sign in</a>
    <span class="auth-footer__sep">·</span>
    <a href="<%= basePath %>/sub/login">Subcontractor sign in</a>
  </p>
</main>

<%- include('../partials/auth-footer') %>
<%- include('../partials/footer') %>
