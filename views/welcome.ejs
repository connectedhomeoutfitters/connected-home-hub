<%- include('partials/head', { title: 'Welcome to ConnectedWorkOS' }) %>
<%- include('partials/nav') %>

<div class="container py-4" style="max-width: 820px;">

  <div class="mb-4">
    <p class="text-muted small text-uppercase mb-1" style="letter-spacing:.14em;">Welcome</p>
    <h1 class="h3 mb-2">You're signed in to ConnectedWorkOS as <%= setup.orgName %></h1>
    <p class="text-muted mb-0">
      This is where the work happens — quotes, jobs, scheduling and invoicing. Payments you
      collect here post straight back into your books in Connected Home Ledger, so you
      won't enter anything twice.
    </p>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h2 class="h6 text-uppercase text-muted mb-3" style="letter-spacing:.1em;">How a job runs</h2>
      <ol class="cho-welcome__flow">
        <li><strong>Quote it</strong> — build it from your price list or type the lines.</li>
        <li><strong>They sign it</strong> — the customer opens a link and signs; no login.</li>
        <li><strong>Take the deposit</strong> — by card, into your own Stripe account.</li>
        <li><strong>Do the work</strong> — schedule it, take the materials off the shelf.</li>
        <li><strong>Bill the balance</strong> — raised automatically when you mark it done.</li>
      </ol>
    </div>
  </div>

  <h2 class="h5 mb-3">Before your first quote</h2>
  <ul class="cho-setup__list mb-4">
    <% setup.items.forEach(function (item) { %>
      <li class="cho-setup__item<%= item.done ? ' is-done' : '' %>">
        <i class="bi <%= item.done ? 'bi-check-circle-fill' : 'bi-circle' %>"></i>
        <div class="cho-setup__text">
          <span class="cho-setup__title">
            <%= item.title %>
            <% if (item.optional && !item.done) { %><span class="cho-setup__opt">optional</span><% } %>
            <% if (item.blocking && !item.done) { %><span class="cho-setup__block">blocks payments</span><% } %>
          </span>
          <span class="cho-setup__body"><%= item.body %></span>
        </div>
        <% if (!item.done) { %>
          <a class="btn btn-sm btn-outline-primary" href="<%= basePath %><%= item.href %>"><%= item.cta %></a>
        <% } %>
      </li>
    <% }); %>
  </ul>

  <div class="d-flex flex-wrap gap-2 align-items-center">
    <a href="<%= basePath %>/admin/settings/payments" class="btn btn-primary">Start with Stripe</a>
    <a href="<%= basePath %>/" class="btn btn-outline-secondary">Skip for now</a>
    <span class="text-muted small ms-1">You can pick this up any time — the checklist stays on your dashboard.</span>
  </div>

</div>
<%- include('partials/footer') %>
