<%- include('../partials/head', { title: 'Payment' }) %>
<%- include('../partials/nav') %>
<%
  function statusBadge(s) {
    const map = { succeeded: 'bg-success', pending: 'bg-warning text-dark', failed: 'bg-danger',
      paid: 'bg-success', refunded: 'bg-secondary', void: 'bg-secondary', canceled: 'bg-secondary' };
    return `<span class="badge ${map[s] || 'bg-secondary'}">${s}</span>`;
  }
%>
<div class="container" style="max-width: 820px;">
  <a href="<%= basePath %>/admin/payments" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Payments</a>
  <h1 class="h3 mt-2 mb-4">Payment #<%= payment.id %></h1>

  <% if (saved) { %>
    <div class="alert alert-success">Refund submitted to Stripe.</div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <div class="card mb-4">
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-sm-4 text-muted fw-normal">Customer</dt>
        <dd class="col-sm-8"><a href="<%= basePath %>/admin/customers/<%= payment.customer_id %>"><%= payment.customer_name %></a> · <%= payment.customer_email %></dd>

        <dt class="col-sm-4 text-muted fw-normal">Invoice</dt>
        <dd class="col-sm-8"><%= payment.invoice_type %> · <%- statusBadge(payment.invoice_status) %></dd>

        <dt class="col-sm-4 text-muted fw-normal">Amount</dt>
        <dd class="col-sm-8">$<%= Number(payment.amount).toFixed(2) %></dd>

        <dt class="col-sm-4 text-muted fw-normal">Refunded</dt>
        <dd class="col-sm-8"><%= Number(payment.amount_refunded) > 0 ? '$' + Number(payment.amount_refunded).toFixed(2) : '—' %></dd>

        <dt class="col-sm-4 text-muted fw-normal">Payment status</dt>
        <dd class="col-sm-8"><%- statusBadge(payment.status) %></dd>

        <dt class="col-sm-4 text-muted fw-normal">Card</dt>
        <dd class="col-sm-8"><%= payment.card_brand ? payment.card_brand + ' ••••' + (payment.card_last4 || '') : '—' %></dd>

        <dt class="col-sm-4 text-muted fw-normal">Date</dt>
        <dd class="col-sm-8"><%= new Date(payment.created_at).toLocaleString() %></dd>

        <dt class="col-sm-4 text-muted fw-normal">Stripe PaymentIntent</dt>
        <dd class="col-sm-8"><code class="small"><%= payment.stripe_payment_intent_id %></code></dd>

        <% if (payment.receipt_url) { %>
          <dt class="col-sm-4 text-muted fw-normal">Receipt</dt>
          <dd class="col-sm-8"><a href="<%= payment.receipt_url %>" target="_blank" rel="noopener">View Stripe receipt <i class="bi bi-box-arrow-up-right small"></i></a></dd>
        <% } %>
      </dl>
    </div>
  </div>

  <!-- Refund history -->
  <h2 class="h5 mb-3">Refunds</h2>
  <% if (!refunds.length) { %>
    <p class="text-muted">No refunds against this payment.</p>
  <% } else { %>
    <div class="table-responsive mb-4">
      <table class="table table-sm align-middle">
        <thead><tr><th>Date</th><th class="text-end">Amount</th><th>Reason</th><th>By</th><th>Status</th></tr></thead>
        <tbody>
          <% refunds.forEach(r => { %>
            <tr>
              <td class="small text-nowrap"><%= new Date(r.created_at).toLocaleDateString() %></td>
              <td class="text-end">$<%= Number(r.amount).toFixed(2) %></td>
              <td class="small"><%= r.reason || '—' %><% if (r.note) { %><div class="text-muted"><%= r.note %></div><% } %></td>
              <td class="small"><%= r.created_by_name || '—' %></td>
              <td><%- statusBadge(r.status) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <!-- Refund form — admins only, only while a payable balance remains -->
  <% if (user && user.role === 'admin') { %>
    <% if (payment.status === 'succeeded' && refundable > 0) { %>
      <div class="card border-danger-subtle">
        <div class="card-header bg-danger-subtle">Issue a refund</div>
        <div class="card-body">
          <form method="POST" action="<%= basePath %>/admin/payments/<%= payment.id %>/refund">
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label">Amount</label>
                <div class="input-group">
                  <span class="input-group-text">$</span>
                  <input type="number" step="0.01" min="0.01" max="<%= refundable.toFixed(2) %>"
                    name="amount" class="form-control" placeholder="<%= refundable.toFixed(2) %>">
                </div>
                <div class="form-text">Blank = full remaining $<%= refundable.toFixed(2) %></div>
              </div>
              <div class="col-md-4">
                <label class="form-label">Reason</label>
                <select name="reason" class="form-select">
                  <option value="">— (none) —</option>
                  <option value="requested_by_customer">Requested by customer</option>
                  <option value="duplicate">Duplicate</option>
                  <option value="fraudulent">Fraudulent</option>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label">Internal note</label>
                <input type="text" name="note" class="form-control" maxlength="500" placeholder="optional">
              </div>
            </div>
            <button type="submit" class="btn btn-danger mt-3">
              <i class="bi bi-arrow-counterclockwise"></i> Refund to Stripe
            </button>
            <span class="text-muted small ms-2">This returns money to the customer's card and can't be undone.</span>
          </form>
        </div>
      </div>
    <% } else if (payment.status === 'succeeded') { %>
      <p class="text-muted">Fully refunded — nothing left to refund.</p>
    <% } else { %>
      <p class="text-muted">Only a succeeded payment can be refunded.</p>
    <% } %>
  <% } %>
</div>
<%- include('../partials/footer') %>
