<%- include('../partials/head', { title: builder.name }) %>
<%- include('../partials/nav') %>
<% const money = (n) => '$' + Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); %>
<div class="container" style="max-width: 800px;">
  <a href="<%= basePath %>/admin/builders" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Builders</a>
  <div class="d-flex justify-content-between align-items-center mt-2 mb-3">
    <h1 class="h3 mb-0"><%= builder.name %><% if (!builder.active) { %> <span class="badge bg-secondary">inactive</span><% } %></h1>
    <a class="btn btn-sm btn-outline-secondary" href="<%= basePath %>/admin/builders/<%= builder.id %>/edit">Edit</a>
  </div>

  <div class="card card-body mb-4">
    <div class="row small">
      <div class="col-md-3"><span class="text-muted">Contact</span><br><%= builder.contact_name || '—' %></div>
      <div class="col-md-3"><span class="text-muted">Phone</span><br><% if (builder.phone) { %><a href="tel:<%= builder.phone %>"><%= builder.phone %></a><% } else { %>—<% } %></div>
      <div class="col-md-3"><span class="text-muted">Email</span><br><% if (builder.email) { %><a href="mailto:<%= builder.email %>"><%= builder.email %></a><% } else { %>—<% } %></div>
      <div class="col-md-3"><span class="text-muted">Referred revenue</span><br><span class="fw-semibold"><%= money(totalRevenue) %></span></div>
      <% if (builder.address) { %><div class="col-12 mt-2"><span class="text-muted">Address</span><br><%= builder.address %></div><% } %>
      <% if (builder.notes) { %><div class="col-12 mt-2"><span class="text-muted">Notes</span><br><%= builder.notes %></div><% } %>
    </div>
  </div>

  <h2 class="h5 mb-3">Referred customers</h2>
  <% if (!customers.length) { %>
    <p class="text-muted">No customers attributed to this builder yet — set the referring builder on a customer's edit page.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead><tr><th>Customer</th><th>Email</th><th class="text-end">Revenue</th></tr></thead>
        <tbody>
          <% customers.forEach(c => { %>
            <tr>
              <td><a href="<%= basePath %>/admin/customers/<%= c.id %>"><%= c.name %></a></td>
              <td class="small"><%= c.email %></td>
              <td class="text-end"><%= money(c.revenue) %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot><tr class="fw-semibold"><td colspan="2" class="text-end">Total</td><td class="text-end"><%= money(totalRevenue) %></td></tr></tfoot>
      </table>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
