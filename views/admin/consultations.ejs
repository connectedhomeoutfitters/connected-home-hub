<%- include('../partials/head', { title: 'Consultations' }) %>
<%- include('../partials/nav') %>
<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Consultations</h1>
    <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#newConsultation">
      + New Consultation
    </button>
  </div>

  <% if (typeof omw !== 'undefined' && omw) { %>
    <% if (omw.noemail) { %>
      <div class="alert alert-warning">No email on file for <strong><%= omw.name %></strong> — the "on my way" message couldn't be sent.</div>
    <% } else { %>
      <div class="alert alert-success"><i class="bi bi-check-circle"></i> "On my way" message sent to <strong><%= omw.name %></strong>.</div>
    <% } %>
  <% } %>

  <div class="collapse mb-4" id="newConsultation">
    <div class="card card-body">
      <% if (customers.length === 0) { %>
        <p class="text-muted mb-0">No customers yet — <a href="<%= basePath %>/admin/customers">add one</a> first (or convert a lead) before starting a consultation.</p>
      <% } else { %>
        <form action="<%= basePath %>/admin/consultations/new" method="GET" class="row g-2">
          <div class="col-md-8">
            <select name="customer_id" class="form-select" required>
              <option value="">Select a customer&hellip;</option>
              <% customers.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-4">
            <button class="btn btn-primary w-100" type="submit">Start</button>
          </div>
        </form>
      <% } %>
    </div>
  </div>

  <%
    const statusLabels = { scheduled: 'Scheduled', completed: 'Completed', on_hold: 'On Hold', cancelled: 'Cancelled' };
    const statusBadges = { scheduled: 'secondary', completed: 'success', on_hold: 'warning', cancelled: 'dark' };
  %>
  <table class="table table-sm align-middle">
    <thead><tr><th>Customer</th><th>Date</th><th>Status</th><th>Timeline</th><th>Budget</th><th></th></tr></thead>
    <tbody>
      <% consultations.forEach(co => { %>
        <tr>
          <td><%= co.customer_name %></td>
          <td><%= co.consultation_date || '' %></td>
          <td><span class="badge bg-<%= statusBadges[co.status] || 'secondary' %>"><%= statusLabels[co.status] || co.status %></span></td>
          <td><%= co.desired_timeline || '' %></td>
          <td><%= co.budget_range || '' %></td>
          <td class="text-end">
            <% if (co.status === 'scheduled') { %>
              <a class="btn btn-sm btn-primary" href="<%= basePath %>/admin/consultations/<%= co.id %>/edit">Conduct Site Visit</a>
              <a class="btn btn-sm btn-outline-secondary" href="<%= basePath %>/admin/consultations/<%= co.id %>/edit#rescheduleBox">Alert of Change</a>
              <% if (co.on_the_way_sent_at) { %>
                <span class="text-success small me-1" title="Sent <%= new Date(co.on_the_way_sent_at).toLocaleString() %>"><i class="bi bi-check-circle-fill"></i> On my way sent</span>
                <form action="<%= basePath %>/admin/consultations/<%= co.id %>/on-the-way" method="POST" class="d-inline omw-form">
                  <button class="btn btn-sm btn-link p-0 align-baseline" type="submit">resend</button>
                </form>
              <% } else { %>
                <form action="<%= basePath %>/admin/consultations/<%= co.id %>/on-the-way" method="POST" class="d-inline omw-form">
                  <button class="btn btn-sm btn-outline-success" type="submit">On My Way</button>
                </form>
              <% } %>
            <% } else { %>
              <a class="btn btn-sm btn-outline-secondary" href="<%= basePath %>/admin/consultations/<%= co.id %>/edit">Open</a>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (consultations.length === 0) { %>
        <tr><td colspan="6" class="text-muted">No consultations yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<script nonce="<%= cspNonce %>">
  // Disable the "On My Way" button the moment it's clicked, so it can't be double-sent
  // during the request (the button then shows a persistent sent state after the reload).
  document.querySelectorAll('form.omw-form').forEach((f) => {
    f.addEventListener('submit', () => {
      const b = f.querySelector('button');
      if (b) { b.disabled = true; b.textContent = 'Sending…'; }
    });
  });
</script>
<%- include('../partials/footer') %>
