<%- include('../partials/head', { title: 'Labor Rates' }) %>
<%- include('../partials/nav') %>
<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Labor Rates</h1>
    <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#addRate">
      + Add Labor Rate
    </button>
  </div>

  <div class="collapse mb-4" id="addRate">
    <div class="card card-body">
      <form action="<%= basePath %>/admin/labor-rates" method="POST">
        <div class="row g-2">
          <div class="col-md-5">
            <label class="form-label">Name</label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Low Voltage Technician" required>
          </div>
          <div class="col-md-3">
            <label class="form-label">Hourly Rate</label>
            <input type="number" step="0.01" name="hourly_rate" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label">Notes</label>
            <input type="text" name="notes" class="form-control">
          </div>
        </div>
        <button class="btn btn-primary mt-3" type="submit">Save Rate</button>
      </form>
    </div>
  </div>

  <table class="table table-sm align-middle">
    <thead><tr><th>Name</th><th>Hourly Rate</th><th>Notes</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% laborRates.forEach(r => { %>
        <tr class="<%= r.active ? '' : 'text-muted' %>">
          <td><%= r.name %></td>
          <td>$<%= Number(r.hourly_rate).toFixed(2) %>/hr</td>
          <td><%= r.notes || '' %></td>
          <td><%= r.active ? 'Active' : 'Inactive' %></td>
          <td class="text-end">
            <a class="btn btn-sm btn-outline-secondary" href="<%= basePath %>/admin/labor-rates/<%= r.id %>/edit">Edit</a>
            <form action="<%= basePath %>/admin/labor-rates/<%= r.id %>/toggle-active" method="POST" class="d-inline">
              <button class="btn btn-sm btn-outline-secondary" type="submit"><%= r.active ? 'Deactivate' : 'Reactivate' %></button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
