<%- include('../partials/head', { title: 'Edit Staff User' }) %>
<%- include('../partials/nav') %>
<div class="container" style="max-width: 600px;">
  <h1 class="h3 mb-4">Edit Staff User</h1>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <form action="<%= basePath %>/admin/settings/users/<%= targetUser.id %>" method="POST">
    <div class="mb-3">
      <label class="form-label">Name</label>
      <input type="text" name="name" class="form-control" value="<%= targetUser.name %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Email</label>
      <input type="email" class="form-control" value="<%= targetUser.email %>" disabled>
      <div class="form-text">Email can't be changed here — create a new account instead if it's wrong.</div>
    </div>
    <div class="row g-2 mb-3">
      <div class="col-md-6">
        <label class="form-label">Role</label>
        <select name="role" class="form-select">
          <option value="staff" <%= targetUser.role === 'staff' ? 'selected' : '' %>>Staff</option>
          <option value="admin" <%= targetUser.role === 'admin' ? 'selected' : '' %>>Admin</option>
        </select>
      </div>
      <div class="col-md-6 d-flex align-items-end">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="active" id="active" <%= targetUser.active ? 'checked' : '' %>>
          <label class="form-check-label" for="active">Active (can log in)</label>
        </div>
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label">Reset Password</label>
      <input type="password" name="password" class="form-control" placeholder="Leave blank to keep current password" autocomplete="new-password">
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-outline-secondary" href="<%= basePath %>/admin/settings/users">Cancel</a>
  </form>
</div>
<%- include('../partials/footer') %>
