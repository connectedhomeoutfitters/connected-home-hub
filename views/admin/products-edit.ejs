<%- include('../partials/head', { title: 'Edit Product' }) %>
<%- include('../partials/nav') %>
<div class="container" style="max-width: 700px;">
  <h1 class="h3 mb-4">Edit Product</h1>
  <form action="<%= basePath %>/admin/products/<%= product.id %>" method="POST">
    <div class="row g-2">
      <div class="col-md-4">
        <label class="form-label">Category</label>
        <input type="text" name="category" class="form-control" value="<%= product.category %>" required>
      </div>
      <div class="col-md-4">
        <label class="form-label">Vendor</label>
        <input type="text" name="vendor" class="form-control" value="<%= product.vendor || '' %>">
      </div>
      <div class="col-md-4">
        <label class="form-label">Product Line</label>
        <input type="text" name="product_line" class="form-control" value="<%= product.product_line || '' %>">
      </div>
      <div class="col-12">
        <label class="form-label">Name</label>
        <input type="text" name="name" class="form-control" value="<%= product.name %>" required>
      </div>
      <div class="col-12">
        <label class="form-label">Description</label>
        <input type="text" name="description" class="form-control" value="<%= product.description || '' %>">
      </div>
      <div class="col-md-6">
        <label class="form-label">Part Number</label>
        <input type="text" name="part_number" class="form-control" value="<%= product.part_number || '' %>">
      </div>
      <div class="col-md-6">
        <label class="form-label">Unit of Measure</label>
        <input type="text" name="unit_of_measure" class="form-control" value="<%= product.unit_of_measure %>">
      </div>
      <div class="col-md-4">
        <label class="form-label">Vendor Cost</label>
        <input type="number" step="0.01" name="vendor_cost" class="form-control" value="<%= product.vendor_cost %>" required>
      </div>
      <div class="col-md-4">
        <label class="form-label">Markup %</label>
        <input type="number" step="0.01" name="markup_percent" class="form-control" value="<%= product.markup_percent || '' %>">
      </div>
      <div class="col-md-4">
        <label class="form-label">Retail Price (if markup disabled)</label>
        <input type="number" step="0.01" name="retail_price" class="form-control" value="<%= product.retail_price %>">
      </div>
      <div class="col-12">
        <label class="form-label">Reference URL</label>
        <input type="url" name="reference_url" class="form-control" value="<%= product.reference_url || '' %>">
      </div>
      <div class="col-12 d-flex gap-3 flex-wrap align-items-end">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="markup_enabled" id="markup_enabled" <%= product.markup_enabled ? 'checked' : '' %>>
          <label class="form-check-label" for="markup_enabled">Auto markup</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="taxable" id="taxable" <%= product.taxable ? 'checked' : '' %>>
          <label class="form-check-label" for="taxable">Taxable</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="track_inventory" id="track_inventory" <%= product.track_inventory ? 'checked' : '' %>>
          <label class="form-check-label" for="track_inventory">Track inventory</label>
        </div>
        <div>
          <label class="form-label small mb-0">Reorder level</label>
          <input type="number" name="reorder_level" class="form-control form-control-sm" style="width:110px;" value="<%= product.reorder_level != null ? product.reorder_level : '' %>" placeholder="—">
        </div>
      </div>
    </div>
    <div class="mt-3">
      <button class="btn btn-primary" type="submit">Save</button>
      <a class="btn btn-outline-secondary" href="<%= basePath %>/admin/products">Cancel</a>
    </div>
  </form>

  <!-- Inventory -->
  <div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span>Inventory</span>
      <span>
        <% if (product.track_inventory) { %>
          <span class="fs-5 fw-semibold"><%= product.stock_qty %></span> in stock
          <% if (product.reorder_level != null && product.stock_qty <= product.reorder_level) { %>
            <span class="badge bg-warning text-dark ms-1">Low</span>
          <% } %>
        <% } else { %>
          <span class="text-muted small">Not tracked — enable "Track inventory" above and Save.</span>
        <% } %>
      </span>
    </div>
    <% if (product.track_inventory) { %>
      <div class="card-body">
        <form action="<%= basePath %>/admin/products/<%= product.id %>/stock" method="POST" class="row g-2 align-items-end mb-3">
          <div class="col-auto">
            <label class="form-label small mb-1">Action</label>
            <select name="mode" class="form-select form-select-sm">
              <option value="receive">Receive (add)</option>
              <option value="set">Set to</option>
            </select>
          </div>
          <div class="col-auto">
            <label class="form-label small mb-1">Quantity</label>
            <input type="number" name="qty" class="form-control form-control-sm" style="width:120px;" required>
          </div>
          <div class="col">
            <label class="form-label small mb-1">Note</label>
            <input type="text" name="note" class="form-control form-control-sm" placeholder="optional">
          </div>
          <div class="col-auto"><button class="btn btn-primary btn-sm" type="submit">Apply</button></div>
        </form>
        <% if (movements.length) { %>
          <table class="table table-sm mb-0">
            <thead><tr><th>When</th><th>Change</th><th>Reason</th><th>Note</th><th>By</th></tr></thead>
            <tbody>
              <% movements.forEach(mv => { %>
                <tr>
                  <td class="small text-nowrap"><%= new Date(mv.created_at).toLocaleDateString() %></td>
                  <td class="<%= mv.delta < 0 ? 'text-danger' : 'text-success' %>"><%= mv.delta > 0 ? '+' : '' %><%= mv.delta %></td>
                  <td class="small text-capitalize"><%= mv.reason %></td>
                  <td class="small text-muted"><%= mv.note || '' %></td>
                  <td class="small"><%= mv.by_name || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %><p class="text-muted small mb-0">No stock movements yet.</p><% } %>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
