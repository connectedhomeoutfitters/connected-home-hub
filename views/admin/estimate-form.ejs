<%- include('../partials/head', { title: 'Estimate' }) %>
<%- include('../partials/nav') %>
<div class="container" style="max-width: 1080px;">
  <h1 class="h3 mb-1">Estimate &mdash; <%= customer.name %></h1>
  <% if (!isNew) { %>
    <p class="text-muted">
      Status: <span class="badge bg-secondary"><%= estimate.status %></span>
      &middot; <a href="<%= basePath %>/admin/estimates/<%= estimate.id %>/pdf" target="_blank">View PDF</a>
    </p>
  <% } %>
  <% if (!isNew && estimate.accepted_at) { %>
    <div class="card card-body bg-light mb-3 small">
      <strong>Acceptance Record</strong>
      <div>Signed by: <strong><%= estimate.signature_name || '—' %></strong></div>
      <div>Accepted: <%= estimate.accepted_at %></div>
      <div>IP address: <%= estimate.accepted_ip || '—' %></div>
      <div class="text-truncate">Browser: <%= estimate.accepted_user_agent || '—' %></div>
    </div>
  <% } %>
  <% if (consultation) { %>
    <p class="text-muted small">
      <i class="bi bi-clipboard-check"></i> Seeded from the
      <a href="<%= basePath %>/admin/consultations/<%= consultation.id %>/edit">consultation</a>
      on <%= consultation.consultation_date || consultation.created_at %>
    </p>
  <% } %>

  <div class="card card-body mb-3 bg-light">
    <strong>Customer</strong>
    <div class="row mt-1">
      <div class="col-md-3"><span class="text-muted small">Name</span><br><%= customer.name %></div>
      <div class="col-md-3"><span class="text-muted small">Email</span><br><%= customer.email || '' %></div>
      <div class="col-md-3"><span class="text-muted small">Phone</span><br><%= customer.phone || '' %></div>
      <div class="col-md-3"><span class="text-muted small">Address</span><br><%= customer.address || '' %></div>
    </div>
  </div>

  <!-- Start from a template (new estimates only) -->
  <% if (isNew && typeof templates !== 'undefined' && templates.length) { %>
    <form method="GET" action="<%= basePath %>/admin/estimates/new" class="card card-body mb-3 border-primary-subtle">
      <input type="hidden" name="customer_id" value="<%= customer.id %>">
      <% if (estimate.consultation_id) { %><input type="hidden" name="consultation_id" value="<%= estimate.consultation_id %>"><% } %>
      <div class="d-flex align-items-end gap-2 flex-wrap">
        <div class="flex-grow-1" style="max-width: 360px;">
          <label class="form-label mb-1"><i class="bi bi-clipboard-plus"></i> Start from a template</label>
          <select name="template_id" class="form-select form-select-sm">
            <option value="">— none (blank estimate) —</option>
            <% templates.forEach(t => { %>
              <option value="<%= t.id %>" <%= String(selectedTemplateId) === String(t.id) ? 'selected' : '' %>><%= t.name %></option>
            <% }) %>
          </select>
        </div>
        <button class="btn btn-outline-primary btn-sm" type="submit">Load</button>
        <span class="text-muted small">Loads the template's lines below to tweak — replaces anything currently entered.</span>
      </div>
    </form>
  <% } %>

  <form action="<%= isNew ? `${basePath}/admin/estimates` : `${basePath}/admin/estimates/${estimate.id}` %>" method="POST" id="estimate-form">
    <input type="hidden" name="customer_id" value="<%= customer.id %>">
    <input type="hidden" name="consultation_id" value="<%= estimate && estimate.consultation_id ? estimate.consultation_id : '' %>">

    <div class="row mb-3">
      <div class="col-md-8">
        <label class="form-label">Title</label>
        <input type="text" name="title" class="form-control" value="<%= estimate ? estimate.title : '' %>" required>
      </div>
      <div class="col-md-4">
        <label class="form-label">Deposit %</label>
        <input type="number" step="0.01" name="deposit_percent" class="form-control" id="deposit_percent" value="<%= estimate ? estimate.deposit_percent : 50 %>">
      </div>
      <div class="col-12 mt-3">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-control" rows="2"><%= estimate ? (estimate.description || '') : '' %></textarea>
      </div>
    </div>

    <h2 class="h5">Line Items</h2>
    <p class="text-muted small mb-1">
      <strong>Unit Cost</strong> is your cost (COGS) &mdash; auto-filled from the catalog, used for the profitability
      panel and never shown to the customer. Tick <strong>Hide</strong> to show a line to the customer as
      &ldquo;Included&rdquo; instead of a price. Use the arrows to reorder.
    </p>
    <div class="table-responsive">
    <table class="table table-sm align-middle" id="line-items-table">
      <thead>
        <tr>
          <th style="width:15%">Source</th><th>Description</th>
          <th style="width:7%">Qty</th><th style="width:11%">Unit Price</th>
          <th style="width:11%">Unit Cost</th><th style="width:5%" class="text-center">Hide</th>
          <th style="width:11%">Line Total</th><th style="width:9%"></th>
        </tr>
      </thead>
      <tbody id="line-items-body">
        <% items.forEach(item => { %>
          <tr class="line-item-row" data-source="<%= item.product_id ? 'product:' + item.product_id : (item.subcontractor_id ? 'sub:' + item.subcontractor_id : (item.labor_rate_id ? 'labor:' + item.labor_rate_id : '')) %>">
            <td>
              <select name="line_source" class="form-select form-select-sm line-source">
                <option value="">Custom</option>
              </select>
            </td>
            <td><input type="text" name="line_description" class="form-control form-control-sm line-description" value="<%= item.description %>" required></td>
            <td><input type="number" step="0.01" name="line_quantity" class="form-control form-control-sm line-quantity" value="<%= item.quantity %>"></td>
            <td><input type="number" step="0.01" name="line_unit_price" class="form-control form-control-sm line-price" value="<%= item.unit_price %>"></td>
            <td><input type="number" step="0.01" name="line_unit_cost" class="form-control form-control-sm line-cost" value="<%= item.unit_cost != null ? item.unit_cost : 0 %>"></td>
            <td class="text-center">
              <input type="hidden" name="line_hide_price" class="line-hide-price" value="<%= item.hide_price ? '1' : '0' %>">
              <input type="checkbox" class="form-check-input line-hide-toggle" title="Hide this line's price from the customer" <%= item.hide_price ? 'checked' : '' %>>
            </td>
            <td class="line-total">$0.00</td>
            <td class="text-nowrap">
              <button type="button" class="btn btn-sm btn-link text-secondary p-0 me-1 move-up" title="Move up">&uarr;</button>
              <button type="button" class="btn btn-sm btn-link text-secondary p-0 me-1 move-down" title="Move down">&darr;</button>
              <button type="button" class="btn btn-sm btn-link text-danger p-0 remove-line" title="Remove">&times;</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <button type="button" class="btn btn-sm btn-outline-primary mb-3" id="add-line">+ Add Line</button>

    <!-- Cloned by page-estimate-form.js for each new row. A <template> is inert (its
         inputs never submit and its content isn't a live .line-item-row), which also
         means a brand-new estimate with zero server-rendered rows still has something to
         clone from. -->
    <template id="line-row-template">
      <tr class="line-item-row" data-source="">
        <td>
          <select name="line_source" class="form-select form-select-sm line-source">
            <option value="">Custom</option>
          </select>
        </td>
        <td><input type="text" name="line_description" class="form-control form-control-sm line-description" required></td>
        <td><input type="number" step="0.01" name="line_quantity" class="form-control form-control-sm line-quantity"></td>
        <td><input type="number" step="0.01" name="line_unit_price" class="form-control form-control-sm line-price"></td>
        <td><input type="number" step="0.01" name="line_unit_cost" class="form-control form-control-sm line-cost" value="0"></td>
        <td class="text-center">
          <input type="hidden" name="line_hide_price" class="line-hide-price" value="0">
          <input type="checkbox" class="form-check-input line-hide-toggle" title="Hide this line's price from the customer">
        </td>
        <td class="line-total">$0.00</td>
        <td class="text-nowrap">
          <button type="button" class="btn btn-sm btn-link text-secondary p-0 me-1 move-up" title="Move up">&uarr;</button>
          <button type="button" class="btn btn-sm btn-link text-secondary p-0 me-1 move-down" title="Move down">&darr;</button>
          <button type="button" class="btn btn-sm btn-link text-danger p-0 remove-line" title="Remove">&times;</button>
        </td>
      </tr>
    </template>

    <div class="row mt-3 g-3">
      <div class="col-md-6">
        <%- include('../partials/costing-panel', { costing: (typeof costing !== 'undefined' ? costing : null) }) %>
      </div>
      <div class="col-md-6">
        <div class="form-check mb-2">
          <input class="form-check-input" type="checkbox" id="flat-toggle" <%= (estimate && estimate.flat_price != null) ? 'checked' : '' %>>
          <label class="form-check-label" for="flat-toggle">Flat package price <span class="text-muted small">(hide itemized costs from the customer)</span></label>
        </div>
        <div id="flat-price-wrap" class="<%= (estimate && estimate.flat_price != null) ? 'd-flex' : 'd-none' %> justify-content-between align-items-center mb-2">
          <span>Package price</span>
          <input type="number" step="0.01" name="flat_price" id="flat_price" class="form-control form-control-sm w-50 text-end" value="<%= (estimate && estimate.flat_price != null) ? estimate.flat_price : '' %>">
        </div>
        <div id="summary-subtotal-row" class="<%= (estimate && estimate.flat_price != null) ? 'd-none' : 'd-flex' %> justify-content-between"><span>Subtotal</span><span id="summary-subtotal">$0.00</span></div>
        <div class="d-flex justify-content-between align-items-center">
          <span>Tax %</span>
          <input type="number" step="0.01" name="tax_percent" id="tax_percent" class="form-control form-control-sm w-50 text-end" value="<%= estimate ? estimate.tax_percent : 0 %>">
        </div>
        <div class="d-flex justify-content-between"><span>Tax</span><span id="summary-tax">$0.00</span></div>
        <div class="d-flex justify-content-between fs-5"><strong>Total</strong><strong id="summary-total">$0.00</strong></div>
        <div class="text-muted small mt-1" id="flat-tax-note"></div>
        <p class="text-muted small mt-1 mb-0">When a flat package price is set, the customer sees the included items with no per-line prices and this single total; the deposit is billed off it.</p>
      </div>
    </div>

    <% if (!isNew) { %>
      <div class="mt-4 d-flex flex-wrap gap-3 align-items-start">
        <a href="<%= basePath %>/admin/estimates/<%= estimate.id %>/materials" class="btn btn-outline-secondary">
          <i class="bi bi-box-seam"></i> Material list
        </a>
        <!-- "Save as template" lives after </form> below — a <form> can't be nested inside the estimate form. -->
      </div>
    <% } %>

    <% const locked = !isNew && ['accepted', 'declined'].includes(estimate.status); %>
    <% if (!locked) { %>
      <button class="btn btn-primary mt-3" type="submit"><%= isNew ? 'Create Estimate' : 'Save' %></button>
    <% } %>
    <a class="btn btn-outline-secondary mt-3" href="<%= basePath %>/admin/estimates">Cancel</a>
  </form>

  <% if (!isNew) { %>
    <form action="<%= basePath %>/admin/estimates/<%= estimate.id %>/save-as-template" method="POST" class="mt-2">
      <button class="btn btn-outline-secondary btn-sm" type="submit"><i class="bi bi-clipboard-plus"></i> Save as template</button>
      <span class="text-muted small ms-1">Reuse these line items for future estimates.</span>
    </form>
  <% } %>

  <% if (locked) { %>
    <div class="alert alert-secondary mt-4">
      <i class="bi bi-lock"></i> This estimate has been <strong><%= estimate.status %></strong> and is locked from editing —
      it's the signed record of what was agreed. Create a new estimate if changes are needed.
    </div>
  <% } %>

  <% if (!isNew && !locked) { %>
    <form action="<%= basePath %>/admin/estimates/<%= estimate.id %>/send" method="POST" class="mt-4" id="send-estimate-form" data-email="<%= customer.email %>">
      <button class="btn btn-success" type="submit" <%= customer.email ? '' : 'disabled' %>>
        Send to Customer<% if (!customer.email) { %> (no email on file)<% } %>
      </button>
      <% if (estimate.sent_at) { %><span class="text-muted ms-2">Last sent <%= estimate.sent_at %></span><% } %>
    </form>
  <% } %>

  <% if (!isNew && estimate.status === 'accepted') { %>
    <form action="<%= basePath %>/admin/estimates/<%= estimate.id %>/final-invoice" method="POST" class="mt-3">
      <button class="btn btn-primary" type="submit"><i class="bi bi-receipt"></i> Bill final balance</button>
      <span class="text-muted small ms-2">Creates a final invoice for the remaining balance (total minus deposit).</span>
    </form>
  <% } %>
</div>
<script nonce="<%= cspNonce %>">
  window.CHO_HUB_CATALOG = {
    products: <%- JSON.stringify(products) %>,
    laborRates: <%- JSON.stringify(laborRates) %>,
    subcontractors: <%- JSON.stringify(subcontractors || []) %>,
  };
  // Confirm before emailing the estimate (inline onsubmit is blocked by the CSP).
  const sendForm = document.getElementById('send-estimate-form');
  if (sendForm) {
    sendForm.addEventListener('submit', (e) => {
      if (!confirm('Email this estimate to ' + (sendForm.dataset.email || 'the customer') + '?')) e.preventDefault();
    });
  }
</script>
<%- include('../partials/footer') %>
