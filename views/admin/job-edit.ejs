<%- include('../partials/head', { title: 'Edit Job' }) %>
<%- include('../partials/nav') %>
<div class="container" style="max-width: 600px;">
  <h1 class="h3 mb-1">Edit Job</h1>
  <p class="text-muted">
    <%= job.customer_name %> &middot; <span class="badge bg-light text-dark border"><%= job.type.replace('_', ' ') %></span>
  </p>
  <form action="<%= basePath %>/admin/jobs/<%= job.id %>" method="POST">
    <div class="mb-3">
      <label class="form-label">Title</label>
      <input type="text" name="title" class="form-control" value="<%= job.title %>" required>
    </div>
    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">Status</label>
        <select name="status" class="form-select">
          <% ['pending','in_progress','done','cancelled'].forEach(s => { %>
            <option value="<%= s %>" <%= job.status === s ? 'selected' : '' %>><%= s.replace('_',' ') %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label">Assigned To</label>
        <select name="assigned_to" class="form-select">
          <option value="">Unassigned</option>
          <% staff.forEach(s => { %>
            <option value="<%= s.id %>" <%= job.assigned_to === s.id ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label">Due Date</label>
        <input type="date" name="due_date" class="form-control" value="<%= job.due_date || '' %>">
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label">Scheduled At</label>
        <input type="datetime-local" name="scheduled_at" class="form-control"
          value="<%= job.scheduled_at ? job.scheduled_at.replace(' ', 'T').slice(0, 16) : '' %>">
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label">Subcontractor <span class="text-muted">(shows on their portal)</span></label>
        <select name="subcontractor_id" class="form-select">
          <option value="">— none —</option>
          <% subcontractors.forEach(s => { %>
            <option value="<%= s.id %>" <%= job.subcontractor_id === s.id ? 'selected' : '' %>><%= s.name %><%= s.trade ? ' (' + s.trade + ')' : '' %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label">Notes</label>
      <textarea name="notes" class="form-control" rows="3"><%= job.notes || '' %></textarea>
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-outline-secondary" href="<%= basePath %>/admin/jobs">Cancel</a>
  </form>

  <% const money = (n) => '$' + Number(n || 0).toFixed(2); %>

  <% if (closed) { %>
    <div class="alert alert-success mt-4">Step closed out<% if (stepMessage) { %> — the customer has been notified by email<% } %>.</div>
  <% } %>

  <!-- Close out / step completion -->
  <div class="card mt-4">
    <div class="card-header"><%= stepMessage ? stepMessage.label : 'Close out step' %></div>
    <div class="card-body">
      <% if (job.closed_at) { %>
        <p class="mb-0"><i class="bi bi-check-circle-fill text-success"></i> <strong>Closed out</strong> on <%= new Date(job.closed_at).toLocaleString() %><% if (stepMessage) { %> — the customer was notified by email<% } %>.</p>
      <% } else { %>
        <% if (stepMessage && stepMessage.includeWarranties && payment) { %>
          <p class="mb-2">
            Billing:
            <% if (payment.fullyPaid) { %>
              <span class="badge bg-success">Fully paid</span> <span class="text-muted small"><%= money(payment.paid) %> collected</span>
            <% } else if (payment.outstanding > 0) { %>
              <span class="badge bg-warning text-dark">Outstanding <%= money(payment.outstanding) %></span> <span class="text-muted small"><%= money(payment.paid) %> paid</span>
            <% } else { %>
              <span class="text-muted small">No invoices raised yet.</span>
            <% } %>
          </p>
        <% } %>

        <% if (stepMessage) { %>
          <p class="small text-muted mb-2">
            Closing out <%= stepMessage.staffDescription %><% if (stepMessage.includeWarranties) { %>
            (<%= warranties.length %> active warrant<%= warranties.length === 1 ? 'y' : 'ies' %> on file<% if (!warranties.length) { %> — <a href="<%= basePath %>/admin/warranties/new?customer_id=<%= job.customer_id %>">add one first</a><% } %>)<% } %>.
          </p>
          <% if (stepMessage.includeWarranties && warranties.length) { %>
            <ul class="small text-muted mb-3">
              <% warranties.forEach(w => { %><li><%= w.item %><%= w.provider ? ' (' + w.provider + ')' : '' %><%= w.expires_on ? ' — through ' + new Date(w.expires_on).toLocaleDateString() : '' %></li><% }) %>
            </ul>
          <% } %>
        <% } else { %>
          <p class="small text-muted mb-2">This step type has no customer notification — closing out just records that it's complete.</p>
        <% } %>

        <% if (job.status === 'done') { %>
          <form action="<%= basePath %>/admin/jobs/<%= job.id %>/close-out" method="POST" id="closeout-form" data-notify="<%= stepMessage && job.customer_email ? '1' : '0' %>">
            <button class="btn btn-success" type="submit"><i class="bi bi-flag"></i> <%= stepMessage ? stepMessage.button : 'Mark step complete' %></button>
            <% if (stepMessage && stepMessage.includeWarranties && payment && !payment.fullyPaid) { %><span class="text-warning small ms-2">Final balance not fully paid — close out anyway?</span><% } %>
            <% if (stepMessage && !job.customer_email) { %><span class="text-warning small ms-2">No email on file — the customer won't be notified.</span><% } %>
          </form>
        <% } else { %>
          <p class="text-muted small mb-0">Mark the job <strong>done</strong> first, then you can close it out.</p>
        <% } %>
      <% } %>
    </div>
  </div>
</div>
<script nonce="<%= cspNonce %>">
  document.getElementById('closeout-form')?.addEventListener('submit', (e) => {
    const notify = e.currentTarget.dataset.notify === '1';
    const msg = notify ? 'Close out this step and email the customer an update?' : 'Close out this step?';
    if (!confirm(msg)) e.preventDefault();
  });
</script>
<%- include('../partials/footer') %>
