<%- include('../partials/head', { title: estimate.title, portalBranded: true, bodyClass: 'portal-page' }) %>
<%- include('../partials/portal-header') %>
<div class="container py-5" style="max-width: 700px;">
  <h1 class="h3"><%= estimate.title %></h1>
  <p class="text-muted"><%= estimate.description %></p>
  <p><a href="<%= basePath %>/e/<%= token %>/pdf" target="_blank">Download as PDF</a></p>

  <% if (estimate.flat_price != null) { %>
    <!-- Flat-rate package: the customer sees what's included with no per-line pricing. -->
    <% if (items.length) { %>
      <p class="fw-semibold mb-1">This package includes:</p>
      <ul>
        <% items.forEach(i => { %><li><%= i.description %></li><% }) %>
      </ul>
    <% } %>
    <p class="fs-5 mt-3 mb-1">Package price: <strong>$<%= estimate.flat_price %></strong></p>
    <% if (Number(estimate.tax) > 0) { %>
      <p class="mb-1">Sales tax: <strong>$<%= estimate.tax %></strong></p>
    <% } %>
    <p class="fs-4">Total: <strong>$<%= estimate.total %></strong></p>
    <p>Deposit due to begin (<%= estimate.deposit_percent %>%): <strong>$<%= estimate.deposit_amount %></strong></p>
  <% } else { %>
    <table class="table">
      <thead><tr><th>Item</th><th>Qty</th><th class="text-end">Price</th></tr></thead>
      <tbody>
        <% items.forEach(i => { %>
          <tr>
            <td><%= i.description %></td>
            <td><%= i.quantity %></td>
            <td class="text-end"><% if (i.hide_price) { %><span class="text-muted">Included</span><% } else { %>$<%= i.unit_price %><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <p>Subtotal: $<%= estimate.subtotal %></p>
    <p>Tax: $<%= estimate.tax %></p>
    <p class="fs-5">Total: <strong>$<%= estimate.total %></strong></p>
    <p>Deposit due to begin (<%= estimate.deposit_percent %>%): <strong>$<%= estimate.deposit_amount %></strong></p>
  <% } %>

  <% if (estimate.status === 'sent') { %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <div class="card card-body bg-light mb-3" style="max-height: 240px; overflow-y: auto; font-size: 0.85rem;"><%- terms %></div>
    <form method="POST" action="<%= basePath %>/e/<%= token %>/accept">
      <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="agree_terms" id="agree_terms" required>
        <label class="form-check-label" for="agree_terms">I have read and agree to the Terms &amp; Conditions above</label>
      </div>
      <div class="mb-3">
        <label class="form-label" for="signature_name">Type your full name as your electronic signature</label>
        <input type="text" class="form-control" name="signature_name" id="signature_name" placeholder="Full legal name" required
          value="<%= (typeof signatureName !== 'undefined' && signatureName) ? signatureName.replace(/"/g, '&quot;') : '' %>">
      </div>
      <button class="btn btn-success">Accept Estimate</button>
    </form>
    <hr class="my-4">
    <p class="text-muted small mb-2">Not ready to move forward?</p>
    <form method="POST" action="<%= basePath %>/e/<%= token %>/decline">
      <button class="btn btn-outline-secondary btn-sm" type="submit">Decline this estimate</button>
    </form>
  <% } else { %>
    <p class="badge bg-secondary"><%= estimate.status %></p>
    <% if (estimate.status === 'accepted') { %>
      <p class="text-muted">Accepted on <%= estimate.accepted_at %>. Check your email for the deposit payment link.</p>
    <% } else if (estimate.status === 'declined') { %>
      <p class="text-muted">You declined this estimate<%= estimate.declined_at ? ' on ' + new Date(estimate.declined_at).toLocaleDateString() : '' %>.
        If that was a mistake or you'd like to revisit it, just reach out and we'll be happy to help.</p>
    <% } %>
  <% } %>
</div>
<%- include('../partials/footer') %>
