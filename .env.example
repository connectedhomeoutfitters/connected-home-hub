NODE_ENV=development
PORT=3100
BASE_URL=http://localhost:3100

SESSION_SECRET=change-me

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=choHub
DB_USER=choHubWeb
DB_PASSWORD=

# Staff auth: local (bcrypt) always available; Google OAuth is optional — the
# GoogleStrategy only registers if GOOGLE_CLIENT_ID is set (see config/passport.js).
# Google sign-in never creates accounts, it only attaches to an existing staff row by
# email (create staff accounts first via scripts/create-admin.js).
# Customers never get a password; they access estimates/invoices via signed token links.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3100/google/callback

# Stripe — same account as ConnectedHomeLedger (Connected Home Outfitters LLC).
# Register a SEPARATE webhook endpoint in Stripe for this app (this app's URL, not
# Ledger's) pointing at /webhooks/stripe, subscribed to payment_intent.succeeded.
# Use its own signing secret below — every event that lands here still gets filtered
# to metadata.source === 'cho-hub' since Ledger's PaymentIntents will also arrive here.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Signing secret for the SECOND webhook endpoint — the Connect one, which delivers events
# from connected accounts (every tenant except org 1). Two endpoints are required because
# a webhook's `connect` flag is IMMUTABLE after creation, so an account-only endpoint can't
# be upgraded. Both point at the same /webhooks/stripe URL; routes/webhooks.js tries each
# secret in turn. Leave unset until the Connect endpoint is registered.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Stripe Connect (phase 4 of docs/adr/0001-multi-tenancy.md). Each tenant except org 1
# connects their OWN Stripe account, so their customers' money settles to them and we
# never take custody of it. This is the platform's Connect client id, from Stripe
# Dashboard → Settings → Connect → Platform settings (ca_...). Add
# <BASE_URL>/admin/settings/payments/callback as an authorized redirect URI there.
# Also enable "Listen to events on Connected accounts" on this app's webhook endpoint so
# payment_intent.succeeded / charge.refunded arrive for connected tenants.
# Unset = Connect is simply unavailable; org 1 keeps billing on the platform account.
STRIPE_CONNECT_CLIENT_ID=

# Outbound email for estimate/invoice/payment-receipt notifications
# Shared secret checked against the X-CHO-Hub-Secret header on inbound lead webhooks
# from choProject's WordPress site (see routes/webhooks.js POST /wpforms-lead).
# Now also the org-1 fallback: each tenant can have its own orgs.lead_webhook_secret.
LEAD_WEBHOOK_SECRET=

# Connected Home Ledger SSO (phase 3 of docs/adr/0001-multi-tenancy.md).
# Must be IDENTICAL to LEDGER_SSO_SECRET / HUB_SSO_SECRET in gymrProject's .env — Ledger
# signs the handoff token with it and Hub verifies. Also authenticates Ledger's inbound
# entitlement webhook (POST /webhooks/ledger-entitlement, X-Ledger-Secret header).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEDGER_SSO_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Connected Home Outfitters <billing@connectedhomeoutfitters.com>"
