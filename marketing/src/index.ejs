<div class="field field--glow field--fade">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Operating system for your connected business</p>
      <h1>Every job, <em>start to paid.</em></h1>
      <p class="lede hero__lede">
        ConnectedWorkOS runs the whole job for small service businesses — lawn care,
        repair, HVAC, plumbing, cleaning and the trades in between. The quote, the
        deposit, the schedule, the final invoice. Every payment you collect posts
        straight into your books.
      </p>
      <div class="actions">
        <a class="btn btn--go" href="https://connectedhomeledger.com">Start with Connected Home Ledger</a>
        <a class="btn btn--ghost" href="#start">Book a walkthrough</a>
      </div>
      <p class="hero__note">Your Stripe or Square account · Your bank · No card data touches us</p>

      <%# The 60s tour: silent, captioned, muted autoplay loop on desktop. Phones and
          reduced-motion visitors get the poster and a play button instead, since 16:9
          captions are unreadable at phone width. Source is tools/explainer-video/ — edit
          explainer.html and re-run render.js; never edit the MP4. %>
      <figure class="tourvid" id="tour">
        <video id="hero-video" muted loop playsinline preload="metadata"
               width="1280" height="720" poster="<%= tourVideo.poster %>"
               aria-label="<%= tourVideo.description %>">
          <source src="<%= tourVideo.src %>" type="video/mp4">
        </video>
        <button type="button" class="tourvid__play" id="hero-video-play" hidden>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor"/></svg>
          Watch the 60-second tour
        </button>
        <button type="button" class="tourvid__ctl tourvid__ctl--fs" id="hero-video-fs" aria-label="Watch fullscreen">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 6V1.5H6M10 1.5h4.5V6M14.5 10v4.5H10M6 14.5H1.5V10" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </button>
        <button type="button" class="tourvid__ctl" id="hero-video-toggle" aria-label="Pause video"></button>
      </figure>
      <details class="tourvid__transcript">
        <summary>Read the transcript</summary>
        <% tourVideo.chapters.forEach(function (c) { c.lines.forEach(function (line) { %><p><%= line %></p><% }); }); %>
        <p><a href="/tour">Watch with chapters &rarr;</a></p>
      </details>
    </div>
  </section>
</div>

<!-- ══ Trades ═══════════════════════════════════════════════════════════════ -->
<section class="band band--paper trades">
  <div class="wrap">
    <p class="eyebrow eyebrow--dark">Who runs on it</p>
    <ul class="trades__list">
      <li>Lawn care &amp; landscaping</li>
      <li>Repair &amp; handyman</li>
      <li>HVAC</li>
      <li>Plumbing</li>
      <li>Electrical</li>
      <li>Cleaning</li>
      <li>Pest control</li>
      <li>Appliance repair</li>
      <li>Pool &amp; spa</li>
      <li>Pressure washing</li>
    </ul>
    <p class="trades__note">
      If you quote work, schedule it, and invoice for it, it fits. Nothing in here assumes
      a particular trade — your price list, your job types, your terms.
    </p>
  </div>
</section>

<!-- ══ The run ══════════════════════════════════════════════════════════════ -->
<div class="field" id="run">
  <section class="band">
    <div class="wrap">
      <div class="band__head">
        <p class="eyebrow">One job, start to finish</p>
        <h2>The paperwork keeps up with the truck</h2>
        <p>
          A job moves in one direction. Each step hands the next one everything it needs,
          so nothing gets retyped and nothing gets forgotten between the first visit and
          the final payment.
        </p>
      </div>

      <ol class="run__list run">
        <li class="stage">
          <span class="stage__no">Step 01</span>
          <h3>The lead lands</h3>
          <p>A form on your website becomes a job in here — not a note you'll lose in the truck.</p>
        </li>
        <li class="stage">
          <span class="stage__no">Step 02</span>
          <h3>You size up the work</h3>
          <p>Quote visit on your phone. Photos, measurements, access notes, and what the customer actually asked for.</p>
        </li>
        <li class="stage">
          <span class="stage__no">Step 03</span>
          <h3>The quote writes itself</h3>
          <p>Pull materials and labour from your own price list, or start from a job you've quoted before. Itemised, or one flat price with the detail kept private.</p>
        </li>
        <li class="stage">
          <span class="stage__no">Step 04</span>
          <h3>They sign it online</h3>
          <p>The customer opens a link, reads your terms and signs. You keep the signature, the timestamp and the address it came from.</p>
        </li>
        <li class="stage stage--pay">
          <span class="stage__no">Step 05 · Money</span>
          <h3>The deposit clears</h3>
          <p>The moment they accept, they can pay the deposit by card. It goes to your Stripe or Square account, not ours.</p>
        </li>
        <li class="stage">
          <span class="stage__no">Step 06</span>
          <h3>The work gets scheduled</h3>
          <p>The job lands on the calendar and on somebody's list, with the materials ready for the truck.</p>
        </li>
        <li class="stage stage--pay">
          <span class="stage__no">Step 07 · Money</span>
          <h3>The balance gets billed</h3>
          <p>Mark the job done and the remaining balance is raised automatically, net of the deposit. Nobody forgets to send the last invoice.</p>
        </li>
        <li class="stage">
          <span class="stage__no">Step 08</span>
          <h3>The warranty is on record</h3>
          <p>Parts, dates and provider stored against the customer. They get the summary; you get a reminder before it lapses.</p>
        </li>
      </ol>
    </div>
  </section>
</div>

<!-- ══ Ledger tie-in ════════════════════════════════════════════════════════ -->
<section class="band band--paper" id="books">
  <div class="wrap">
    <div class="band__head">
      <p class="eyebrow eyebrow--dark">Connected Home Ledger</p>
      <h2>Your books fill themselves in</h2>
      <p>
        ConnectedWorkOS and Connected Home Ledger are two halves of one system. Take a
        deposit or a final payment on a job here, and it posts into your business books
        there as income — dated, categorised, and net of anything you refunded. No CSV
        export, no entering the same payment twice, no shoebox in March.
      </p>
    </div>

    <div class="split">
      <div>
        <div class="cards cards--stack">
          <div class="card">
            <span class="card__tag">Where you start</span>
            <h3>Sign up for Ledger first</h3>
            <p>Create your Connected Home Ledger account and set up your Business Workspace — that's where your books live. ConnectedWorkOS opens from inside it, already signed in.</p>
          </div>
          <div class="card">
            <span class="card__tag">What you stop doing</span>
            <h3>Re-typing your own income</h3>
            <p>Most small shops run jobs in one tool and accounts in another, then reconcile by hand. Here the job and the books are the same system, so there's nothing to reconcile.</p>
          </div>
        </div>
      </div>

      <div class="flow" role="img" aria-label="A one thousand two hundred dollar deposit collected on a job posts into Connected Home Ledger as business income.">
        <div class="flow__head">ConnectedWorkOS · Invoice paid</div>
        <div class="flow__row">
          <span class="flow__label">Deposit · Ridgeline job</span>
          <span class="flow__val flow__val--pay">$1,200.00</span>
        </div>
        <div class="flow__arrow"><span>&#8595;</span> posts automatically</div>
        <div class="flow__head">Connected Home Ledger · Business books</div>
        <div class="flow__row">
          <span class="flow__label">Income · Services</span>
          <span class="flow__val">$1,200.00</span>
        </div>
        <div class="flow__row">
          <span class="flow__label">Entered by hand</span>
          <span class="flow__val">$0.00</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══ Money ════════════════════════════════════════════════════════════════ -->
<section class="band band--tint">
  <div class="wrap">
    <div class="band__head">
      <p class="eyebrow eyebrow--dark">Getting paid</p>
      <h2>The money is yours before it's ours</h2>
      <p>
        Payments run through your own Stripe or Square account, connected in a couple
        of clicks — already on Square? Invoice payments land next to your in-person sales.
        Deposits and final payments reach your bank on your schedule. We never hold your
        money, and card details never touch our servers.
      </p>
    </div>

    <div class="cards cards--three">
      <div class="card">
        <span class="card__tag">Quotes</span>
        <h3>Priced from your own list</h3>
        <p>Your materials, your labour rates, your markup. Save a job you sell often as a package and start the next one from it.</p>
      </div>
      <div class="card">
        <span class="card__tag">Margin</span>
        <h3>You see the profit first</h3>
        <p>Cost sits beside price on every line — materials, labour, subs — so you know the margin before you send it, not after the job.</p>
      </div>
      <div class="card">
        <span class="card__tag">Refunds</span>
        <h3>Handled, and recorded</h3>
        <p>Refund all or part of a payment from the job it belongs to. The customer gets a receipt and your books follow.</p>
      </div>
    </div>

    <p class="fineprint">
      <strong>How payments work:</strong> you connect a Stripe or Square account — one
      you already have, or a Stripe account you create during setup — and you agree to
      that processor's terms directly with them. Payouts go to your bank on your schedule.
      <strong>Card processing fees are charged by Stripe or Square and are separate from
      your subscription.</strong> Until you connect an account you can still quote and
      schedule work, but you cannot take card payments.
    </p>
  </div>
</section>

<!-- ══ Portals ══════════════════════════════════════════════════════════════ -->
<section class="band band--paper">
  <div class="wrap">
    <div class="band__head">
      <p class="eyebrow eyebrow--dark">Everyone else</p>
      <h2>Nobody makes an account to work with you</h2>
    </div>

    <div class="cards">
      <div class="card">
        <span class="card__tag">Customers</span>
        <h3>A link, not a login</h3>
        <p>They open the quote, sign it, pay the deposit and follow the job from the same page. No password to forget, no app to install.</p>
      </div>
      <div class="card">
        <span class="card__tag">Subcontractors</span>
        <h3>Their jobs, and nothing else</h3>
        <p>Crews and subs sign in to see the work assigned to them and their own paperwork — insurance certificates, W-9s. They never see your customers or your pricing.</p>
      </div>
    </div>
  </div>
</section>

<%- include('_cta') %>

<script>
// Hero tour — autoplay unless the visitor prefers reduced motion, a pause/play toggle
// (anything that moves for >5s needs one), and GA progress events. On a phone the 16:9
// captions are too small to read inline, so it does not autoplay there: the play button
// opens it fullscreen instead, where it can be watched in landscape.
(function () {
  var video  = document.getElementById('hero-video');
  var toggle = document.getElementById('hero-video-toggle');
  var big    = document.getElementById('hero-video-play');
  var fsBtn  = document.getElementById('hero-video-fs');
  if (!video || !toggle || !big || !fsBtn) return;
  var phone   = window.matchMedia('(max-width: 768px)').matches;
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var PAUSE = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2.5h2.5v11H4.5zM9 2.5h2.5v11H9z" fill="currentColor"/></svg>';
  var PLAY  = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor"/></svg>';

  function sync() {
    var playing = !video.paused;
    toggle.innerHTML = playing ? PAUSE : PLAY;
    toggle.setAttribute('aria-label', playing ? 'Pause video' : 'Play video');
  }
  video.addEventListener('play', function () { big.hidden = true; toggle.hidden = fsBtn.hidden = false; sync(); });
  video.addEventListener('pause', sync);
  toggle.addEventListener('click', function () { video.paused ? video.play() : video.pause(); });

  function fullscreen() {
    if (video.requestFullscreen) {
      video.requestFullscreen().then(function () {
        if (screen.orientation && screen.orientation.lock) return screen.orientation.lock('landscape');
      }).catch(function () {});
    } else if (video.webkitEnterFullscreen) {
      video.webkitEnterFullscreen();   // iOS Safari: fullscreen only exists on the video element
    }
  }
  fsBtn.addEventListener('click', function () { video.play().catch(function () {}); fullscreen(); });
  big.addEventListener('click', function () {
    video.play().catch(function () {});
    if (phone) fullscreen();
  });

  if (phone || reduced) {
    big.hidden = false;
    toggle.hidden = fsBtn.hidden = true;
  } else {
    video.play().catch(function () { big.hidden = false; toggle.hidden = fsBtn.hidden = true; });
  }
  sync();

  // video_start / video_progress (50%) / video_complete — once each per page view. The video
  // loops, so 'ended' never fires; completion is the first pass near the end.
  var sent = {};
  function track(name, params) {
    if (sent[name] || typeof window.gtag !== 'function') return;
    sent[name] = true;
    window.gtag('event', name, Object.assign({ video_title: 'WorkOS 60s tour', page: 'home' }, params));
  }
  video.addEventListener('timeupdate', function () {
    var d = video.duration;
    if (!d) return;
    var pct = video.currentTime / d;
    if (video.currentTime > 0.5) track('video_start', {});
    if (pct >= 0.5) track('video_progress', { video_percent: 50 });
    if (pct >= 0.95) track('video_complete', { video_percent: 100 });
  });
})();
</script>
